{
  "name": "clytrade",
  "private": true,
  "version": "0.1.0",
  "description": "Fast, local-first trading journal, portfolio tracker and calculator suite (PWA).",
  "license": "GPL-3.0-only",
  "author": "benyamin-git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benyamin-git/ClyTrade.git"
  },
  "keywords": [
    "trading",
    "journal",
    "portfolio",
    "calculators",
    "pwa",
    "local-first",
    "indexeddb",
    "react"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "icons:native": "tauri icon public/icons/icon-512.png",
    "accents": "node scripts/generate-accents.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:install": "playwright install chromium",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:apk": "tauri android build --apk",
    "android:apk:debug": "tauri android build --apk --debug",
    "version:set": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
